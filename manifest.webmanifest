{
  "name": "DJ Battle",
  "short_name": "DJ Battle",
  "description": "Battle other DJs, get AI-judged scores and climb the rankings.",
  "id": "./",
  "start_url": "./index.html#battles",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0b0f14",
  "theme_color": "#0b0f14",
  "categories": [
    "music",
    "entertainment"
  ],
  "icons": [
    {
      "src": "assets/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "assets/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "audio",
          "accept": [
            "audio/*",
            ".mp3",
            ".wav",
            ".aif",
            ".aiff",
            ".flac",
            ".m4a",
            ".aac",
            ".ogg",
            ".opus"
          ]
        }
      ]
    }
  }
}
