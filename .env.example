# Server-only configuration. Do not use these values in browser code.
SUPABASE_URL=<YOUR_SUPABASE_PROJECT_URL>
SUPABASE_KEY=<YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY>
SUPABASE_SERVICE_KEY=<YOUR_SUPABASE_SERVICE_ROLE_KEY>

# Automatic submission judging is off unless explicitly enabled.
SUBMISSION_JUDGE_WORKER_ENABLED=false

# Polling and recovery settings for the background judging runner.
# Keep values conservative in production until monitoring is connected.
SUBMISSION_JUDGE_INTERVAL_MS=10000
SUBMISSION_JUDGE_STALE_MS=900000
SUBMISSION_JUDGE_BACKOFF_BASE_MS=1000
SUBMISSION_JUDGE_MAX_BACKOFF_MS=60000

# Optional FFmpeg executable path. Leave blank to use bundled/PATH discovery.
FFMPEG_PATH=
